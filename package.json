{
  "name": "appointment-api-cicd",
  "version": "1.0.0",
  "private": true,
  "description": "Production-minded appointment booking API for CI/CD practice",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "migrate:up": "dotenv run -- node-pg-migrate up -m migrations",
    "migrate:test": "dotenv run -f .env.test -- node-pg-migrate up -m migrations",
    "db:check": "tsx src/db/check.ts",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run build && npm test",
    "test:integration": "dotenv run -f .env.test -- vitest run src/db/postgres.integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
